{
  "extends": "@serp/config/tsconfig-nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@serp/*": ["../../packages/*/src"],
      "@serp/api/*": ["../api/src/*"]
