{
  "name": "@serp/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*",
      "require": "./dist/*",
      "types": "./dist/*"
    }
  },
  "scripts": {
    "dev": "tsx ../../scripts/env/run.ts -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx ../../scripts/env/run.ts -- node dist/index.js",
    "lint": "eslint src --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run",
    "db:generate": "tsx ../../scripts/env/run.ts -- drizzle-kit generate",
    "db:migrate": "tsx ../../scripts/env/run.ts -- tsx src/db/migrate.ts",
    "db:reset": "tsx ../../scripts/env/run.ts -- tsx src/db/reset.ts"
  },
  "dependencies": {
    "@serp/core": "workspace:*",
    "@serp/db": "workspace:*",
    "@serp/trpc": "workspace:*",
    "@serp/validations": "workspace:*",
    "@trpc/server": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@serp/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.9",
    "drizzle-kit": "^0.29.1",
    "eslint": "^8.57.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
