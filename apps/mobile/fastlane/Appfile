# Appfile for Serp Mobile
# Configure with environment variables or override locally

# iOS
app_identifier(ENV['IOS_BUNDLE_ID'] || 'com.serp.mobile')
apple_id(ENV['APPLE_ID'] || '')
itc_team_id(ENV['ITC_TEAM_ID'] || '')
team_id(ENV['APPLE_TEAM_ID'] || '')

# Android
json_key_file(ENV['ANDROID_JSON_KEY_FILE'] || '')
package_name(ENV['ANDROID_PACKAGE_NAME'] || 'com.serp.mobile')
