{
  "name": "@serp/client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently -k \"pnpm dev\" \"wait-on http://localhost:3000 && cross-env CLIENT_DEV_SERVER_URL=http://localhost:3000 electron -r ts-node/register apps/client/electron/main.ts\"",
    "build": "next build",
    "build:electron:code": "tsc --project tsconfig.electron.json",
    "build:electron": "pnpm build && pnpm build:electron:code && electron-builder",
    "start": "next start",
    "lint": "next lint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@serp/trpc": "workspace:*",
    "@serp/validations": "workspace:*",
    "@serp/api": "workspace:*",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@serp/config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.17.9",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-builder-squirrel-windows": "25.1.8",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.serp.client",
    "productName": "Serp Client",
    "files": [
      "dist-electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      ".next/standalone/**",
      ".next/static/**",
      "public/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    }
  }
}
