{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@serp/config/tsconfig-base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2020", "DOM"],
    "target": "ES2020",
    "moduleResolution": "bundler",
    "downlevelIteration": true,
    "esModuleInterop": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
