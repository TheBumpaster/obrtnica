# Environment Variables Configuration
# Copy this file to .env and fill in your values
# For local development, you can also create .env.local (gitignored) for personal overrides

# Core Runtime
NODE_ENV=development
LOG_LEVEL=info

# API Server
PORT=3001
CORS_ORIGIN=*

# Databases
DATABASE_URL=postgresql://serp:serp_dev@localhost:5432/serp
MONGODB_URL=mongodb://serp:serp_dev@localhost:27017/serp?authSource=admin

# Message Queue
RABBITMQ_URL=amqp://serp:serp_dev@localhost:5672

# Security (REQUIRED in production - change these!)
JWT_SECRET=dev-secret-change-in-production
MFA_ENCRYPTION_KEY=dev-mfa-key-change-in-production

# Worker
WORKER_CONCURRENCY=5
NOTIFICATIONS_DRY_RUN=true
APP_BASE_URL=http://localhost:3000
STORAGE_BASE_PATH=./.local-storage

# Client
NEXT_PUBLIC_API_URL=http://localhost:3001/trpc

# Notification Providers (optional)
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
